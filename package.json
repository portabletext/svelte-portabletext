{
  "name": "@portabletext/svelte",
  "version": "4.0.0",
  "keywords": [
    "portable-text",
    "svelte"
  ],
  "homepage": "https://github.com/portabletext/svelte-portabletext#readme",
  "bugs": {
    "url": "https://github.com/portabletext/svelte-portabletext/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/portabletext/svelte-portabletext.git"
  },
  "license": "MIT",
  "author": "Sanity <hello@sanity.io>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "scripts": {
    "build": "vite build && npm run package",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "dev": "vite dev",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "package": "svelte-kit sync && svelte-package && publint",
    "prepublishOnly": "npm run package",
    "preview": "vite preview",
    "release": "changeset publish",
    "test": "vitest"
  },
  "dependencies": {
    "@portabletext/toolkit": "^6.1.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@portabletext/types": "^4.0.2",
    "@sveltejs/adapter-auto": "^9.0.0",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/package": "^3.0.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@testing-library/svelte": "^5.4.2",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "prettier-plugin-packagejson": "^3.1.0",
    "prettier-plugin-svelte": "^4.2.0",
    "publint": "^0.3.25",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "tslib": "^2.9.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
